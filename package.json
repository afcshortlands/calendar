{
  "name": "AFCS Calendar",
  "version": "1.0.0",
  "description": "AFC Shortlands Pitch Calendar",
  "homepage": "https://github.com/afcshortlands/calendar",
  "bugs": {
    "url": "https://github.com/afcshortlands/calendar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afcshortlands/calendar.git"
  },
  "license": "MIT",
  "author": "Andrew Hayward <mail@andrewhayward.net>",
  "type": "module",
  "scripts": {
    "start": "npx @11ty/eleventy --serve",
    "watch": "npx @11ty/eleventy --watch",
    "build": "npm run build:calendar; npm run build:site",
    "build:calendar": "mkdir -p ./src/data; node ./scripts/calendar.js @.calendars > ./src/data/calendar.json",
    "build:site": "npx @11ty/eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "node-ical": "^0.27.1"
  }
}
